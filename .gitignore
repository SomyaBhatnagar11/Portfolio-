alpha-designs/
├── index.html
├── style.css
└── script.js


<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>Alpha Designs</title>
  <link rel="stylesheet" href="style.css" />
</head>
<body>

  <header>
    <h1>Alpha Designs</h1>
    <nav>
      <a href="#">Home</a>
      <a href="#products">Shop</a>
      <a href="#contact">Contact</a>
    </nav>
  </header>

  <section class="hero">
    <h2>Timeless Decor for Every Season</h2>
    <p>Brass | Garden | Kitchen | Christmas | Home Decor</p>
  </section>

  <section id="products" class="product-section">
    <h2>Featured Products</h2>

    <div class="product-grid">
      <div class="product-card">
        <img src="https://via.placeholder.com/200x150" alt="Brass Urli" />
        <h3>Brass Urli</h3>
        <p>₹1,099</p>
        <button onclick="addToCart()">Add to Cart</button>
      </div>
      <div class="product-card">
        <img src="https://via.placeholder.com/200x150" alt="Garden Tool Kit" />
        <h3>Garden Tool Kit</h3>
        <p>₹499</p>
        <button onclick="addToCart()">Add to Cart</button>
      </div>
      <div class="product-card">
        <img src="https://via.placeholder.com/200x150" alt="Kitchen Spice Rack" />
        <h3>Spice Rack</h3>
        <p>₹799</p>
        <button onclick="addToCart()">Add to Cart</button>
      </div>
      <div class="product-card">
        <img src="https://via.placeholder.com/200x150" alt="Christmas Wreath" />
        <h3>Christmas Wreath</h3>
        <p>₹399</p>
        <button onclick="addToCart()">Add to Cart</button>
      </div>
      <div class="product-card">
        <img src="https://via.placeholder.com/200x150" alt="Wall Hanging Decor" />
        <h3>Wall Hanging</h3>
        <p>₹699</p>
        <button onclick="addToCart()">Add to Cart</button>
      </div>
    </div>
  </section>

  <section id="contact" class="contact-section">
    <h2>Contact Us</h2>
    <form>
      <input type="text" placeholder="Your Name" required />
      <input type="email" placeholder="Your Email" required />
      <textarea placeholder="Your Message" rows="4" required></textarea>
      <button type="submit">Send Message</button>
    </form>
  </section>

  <footer>
    <p>&copy; 2025 Alpha Designs. Crafted with care.</p>
  </footer>

  <script src="script.js"></script>
</body>
</html>


* {
  box-sizing: border-box;
  margin: 0;
  padding: 0;
}

body {
  font-family: 'Segoe UI', sans-serif;
  background: #fefefe;
  color: #333;
}

header {
  background: #2d2d2d;
  color: #fff;
  padding: 1rem 2rem;
  display: flex;
  justify-content: space-between;
  align-items: center;
}

nav a {
  color: #fff;
  text-decoration: none;
  margin-left: 1rem;
}

.hero {
  text-align: center;
  background: #f2f2f2;
  padding: 3rem 1rem;
}

.hero h2 {
  font-size: 2rem;
  margin-bottom: 1rem;
}

.product-section {
  padding: 2rem;
}

.product-section h2 {
  text-align: center;
  margin-bottom: 2rem;
}

.product-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 1rem;
  justify-content: center;
}

.product-card {
  width: 200px;
  background: white;
  border-radius: 8px;
  box-shadow: 0 4px 10px rgba(0,0,0,0.1);
  padding: 1rem;
  text-align: center;
}

.product-card img {
  width: 100%;
  height: auto;
  margin-bottom: 0.5rem;
}

.product-card h3 {
  margin: 0.5rem 0;
}

.product-card button {
  padding: 0.5rem;
  background: #2d2d2d;
  color: white;
  border: none;
  cursor: pointer;
  border-radius: 5px;
}

.contact-section {
  background: #f0f0f0;
  padding: 2rem;
  text-align: center;
}

.contact-section form {
  max-width: 400px;
  margin: auto;
  display: flex;
  flex-direction: column;
  gap: 1rem;
}

.contact-section input,
.contact-section textarea {
  padding: 0.75rem;
  border: 1px solid #ccc;
  border-radius: 5px;
}

footer {
  background: #2d2d2d;
  color: white;
  text-align: center;
  padding: 1rem;
}


function addToCart() {
  alert("Item added to cart! (Demo only)");
}

document.querySelector("form").addEventListener("submit", function(e) {
  e.preventDefault();
  alert("Thank you for contacting Alpha Designs!");
});
